{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "sceneId",
    "title",
    "order",
    "entryConditions",
    "contentRefs",
    "triggerRefs"
  ],
  "properties": {
    "sceneId": {
      "type": "string",
      "pattern": "^(P\\d{2}|A[1-5]-\\d{2})$"
    },
    "title": {
      "type": "string"
    },
    "order": {
      "type": "integer"
    },
    "entryConditions": {
      "type": "array"
    },
    "contentRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "triggerRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checkpoint": {
      "type": "boolean"
    }
  }
}
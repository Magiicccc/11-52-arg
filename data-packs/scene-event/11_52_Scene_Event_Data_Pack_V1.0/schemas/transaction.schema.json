{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "transactionId",
    "atomic",
    "actions",
    "idempotencyKey"
  ],
  "properties": {
    "transactionId": {
      "type": "string"
    },
    "atomic": {
      "const": true
    },
    "actions": {
      "type": "array",
      "minItems": 1
    },
    "idempotencyKey": {
      "type": "string"
    }
  }
}